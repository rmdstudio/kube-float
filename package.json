{
  "name": "kube-float",
  "version": "0.1.0",
  "description": "Visualize a Kubernetes cluster as jellyfish floating in a 3D ocean",
  "license": "MIT",
  "author": "rmd Studio Inc. <info@rmdstudio.com> (https://www.rmdstudio.com)",  "private": true,
  "scripts": {
    "start": "concurrently -k -n k8s,web -c cyan,magenta \"yarn proxy\" \"yarn web\"",
    "web": "react-scripts start",
    "proxy": "kubectl proxy --port=8717 --address=127.0.0.1",
    "demo": "REACT_APP_DEMO=1 react-scripts start",
    "build": "react-scripts build"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "d3-force-3d": "^3.0.6",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-scripts": "^5.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "http-proxy-middleware": "^2.0.9"
  }
}
